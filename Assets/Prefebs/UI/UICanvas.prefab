  _data:
    _json: '{"declarations":{"Kind":"Object","collection":{"$content":[{"name":"\u77e5\u8bc6\u5361\u7247dic","value":{"$content":[{"Key":{"$content":"\u5316\u5b66\u53cd\u5e94","$type":"System.String"},"Value":{"$content":"\u6307\u4e00\u79cd\u6216\u591a\u79cd\u7269\u8d28\u5728\u4e00\u5b9a\u6761\u4ef6\u4e0b\uff0c\u901a\u8fc7\u539f\u5b50\u6216\u5206\u5b50\u7684\u91cd\u65b0\u6392\u5217\uff0c\u751f\u6210\u65b0\u7684\u7269\u8d28\u7684\u8fc7\u7a0b\u3002\u5316\u5b66\u53cd\u5e94\u4f34\u968f\u7740\u65e7\u5316\u5b66\u952e\u65ad\u88c2\u548c\u65b0\u5316\u5b66\u952e\u5f62\u6210\u7684\u8fc7\u7a0b\uff0c\u5bfc\u81f4\u7269\u8d28\u7684\u7ec4\u6210\u548c\u6027\u8d28\u53d1\u751f\u53d8\u5316\u3002","$type":"System.String"}},{"Key":{"$content":"\u5316\u5b66\u65b9\u7a0b\u5f0f","$type":"System.String"},"Value":{"$content":"\u7528\u5316\u5b66\u7b26\u53f7\u548c\u5316\u5b66\u5f0f\u8868\u793a\u5316\u5b66\u53cd\u5e94\u7684\u5f0f\u5b50\u3002\u5b83\u8868\u793a\u53cd\u5e94\u7269\u548c\u751f\u6210\u7269\u7684\u79cd\u7c7b\u3001\u6bd4\u4f8b\u53ca\u53cd\u5e94\u6761\u4ef6\u3002","$type":"System.String"}},{"Key":{"$content":"\u8d28\u91cf\u5b88\u6052","$type":"System.String"},"Value":{"$content":"\u5728\u4efb\u4f55\u4e0e\u5468\u56f4\u9694\u7edd\u7684\u7269\u8d28\u7cfb\u7edf\uff08\u5b64\u7acb\u7cfb\u7edf\uff09\u4e2d\uff0c\u4e0d\u8bba\u53d1\u751f\u4f55\u79cd\u53d8\u5316\u6216\u8fc7\u7a0b\uff0c\u5176\u603b\u8d28\u91cf\u4fdd\u6301\u4e0d\u53d8\u3002\u53c2\u52a0\u5316\u5b66\u53cd\u5e94\u7684\u5404\u7269\u8d28\u7684\u8d28\u91cf\u603b\u548c\uff0c\u7b49\u4e8e\u53cd\u5e94\u540e\u751f\u6210\u7684\u5404\u7269\u8d28\u7684\u8d28\u91cf\u603b\u548c\u3002","$type":"System.String"}},{"Key":{"$content":"\u5316\u5408\u53cd\u5e94","$type":"System.String"},"Value":{"$content":"\u4e24\u79cd\u6216\u4e24\u79cd\u4ee5\u4e0a\u7684\u7269\u8d28\u751f\u6210\u4e00\u79cd\u65b0\u7269\u8d28\u7684\u53cd\u5e94\u3002","$type":"System.String"}},{"Key":{"$content":"\u5206\u89e3\u53cd\u5e94","$type":"System.String"},"Value":{"$content":"\u4e00\u79cd\u5316\u5408\u7269\u5206\u89e3\u6210\u4e24\u79cd\u6216\u4e24\u79cd\u4ee5\u4e0a\u7684\u7269\u8d28\uff08\u5355\u8d28\u6216\u5316\u5408\u7269\uff09\u7684\u53cd\u5e94\u3002","$type":"System.String"}},{"Key":{"$content":"\u7f6e\u6362\u53cd\u5e94","$type":"System.String"},"Value":{"$content":"\u4e00\u79cd\u5355\u8d28\u4e0e\u4e00\u79cd\u5316\u5408\u7269\u53cd\u5e94\uff0c\u751f\u6210\u53e6\u4e00\u79cd\u5355\u8d28\u548c\u53e6\u4e00\u79cd\u5316\u5408\u7269\u7684\u53cd\u5e94\u3002","$type":"System.String"}},{"Key":{"$content":"\u590d\u5206\u89e3\u53cd\u5e94","$type":"System.String"},"Value":{"$content":"\u4e24\u79cd\u5316\u5408\u7269\u76f8\u4e92\u4ea4\u6362\u6210\u5206\uff0c\u751f\u6210\u4e24\u79cd\u65b0\u7684\u5316\u5408\u7269\u7684\u53cd\u5e94\u3002","$type":"System.String"}},{"Key":{"$content":"\u539f\u5b50","$type":"System.String"},"Value":{"$content":"\u539f\u5b50\u662f\u5143\u7d20\u80fd\u591f\u5b58\u5728\u7684\u6700\u5c0f\u5355\u4f4d\u3002\u7269\u8d28\u662f\u7531\u539f\u5b50\u7b49\u5fae\u89c2\u7c92\u5b50\u6784\u6210\u7684\u3002\u539f\u5b50\u7684\u76f4\u5f84\u7ea6\u4e3a0.1\u7eb3\u7c73\uff0c100\u4e07\u4e2a\u539f\u5b50\u53e0\u6210\u4e00\u5f20\u7eb8\u3002","$type":"System.String"}},{"Key":{"$content":"\u5206\u5b50","$type":"System.String"},"Value":{"$content":"\u5206\u5b50\u662f\u4fdd\u6301\u7269\u8d28\u5316\u5b66\u6027\u8d28\u7684\u6700\u5c0f\u7c92\u5b50\uff0c\u7531\u4e24\u4e2a\u6216\u4e24\u4e2a\u4ee5\u4e0a\u7684\u539f\u5b50\u901a\u8fc7\u4e00\u4e2a\u6216\u591a\u4e2a\u5171\u4ef7\u952e\u8fde\u63a5\u800c\u6210\u3002\u5206\u5b50\u662f\u5316\u5b66\u53d8\u5316\u4e2d\u7684\u57fa\u672c\u5355\u4f4d\u3002\u901a\u8fc7\u5206\u5b50\u5f0f\u53ef\u8868\u793a\u5206\u5b50\u7684\u7ec4\u6210\u3002","$type":"System.String"}},{"Key":{"$content":"\u5316\u5b66\u952e","$type":"System.String"},"Value":{"$content":"\u5316\u5b66\u952e\u662f\u539f\u5b50\u4e4b\u95f4\u901a\u8fc7\u76f8\u4e92\u4f5c\u7528\u7ed3\u5408\u5728\u4e00\u8d77\u7684\u4f5c\u7528\u529b\uff0c\u662f\u5f62\u6210\u5206\u5b50\u6216\u5316\u5408\u7269\u7684\u57fa\u7840\u3002\u5e38\u89c1\u5316\u5b66\u952e\u5206\u4e3a\u4ee5\u4e0b\u51e0\u7c7b\uff1a\u5171\u4ef7\u952e\u3001\u79bb\u5b50\u952e\u3001\u91d1\u5c5e\u952e\u3002","$type":"System.String"}}],"$type":"Unity.VisualScripting.AotDictionary"},"typeHandle":{"Identification":"Unity.VisualScripting.AotDictionary,
